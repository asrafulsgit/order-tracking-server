// prisma/schema/food.prisma
// ─── Food Model ────────────────────────────────────────────────────────────────

model Food {
  id          String       @id @default(uuid())
  name        String
  description String
  price       Decimal      @db.Decimal(10, 2)
  category    FoodCategory
  image_url   String?
  available   Boolean      @default(true)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  orders Order[]

  @@map("foods")
}
