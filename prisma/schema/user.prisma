// prisma/schema/user.prisma
// ─── User Model ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(USER) 
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  orders Order[]

  @@index([email])
  @@map("users")
}
